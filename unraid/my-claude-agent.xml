<?xml version="1.0"?>
<!-- Unraid template for the Claude agent. Copy to
     /boot/config/plugins/dockerMan/templates-user/ and create with xmlToCommand.
     GitHub account: matthewjohnward.
     Network: claude-net ONLY (created as an internal network, so no route out except the proxy).
     No secrets in this template: the API key is a file in the /secrets folder. -->
<Container version="2">
  <Name>claude-agent</Name>
  <Repository>ghcr.io/matthewjohnward/nas01-claude-agent:latest</Repository>
  <Registry>https://github.com/matthewjohnward/nas01-claude-agent/pkgs/container/nas01-claude-agent</Registry>
  <Network>claude-net</Network>
  <MyIP>172.31.250.10</MyIP>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/matthewjohnward/nas01-claude-agent</Support>
  <Project>https://github.com/matthewjohnward/nas01-claude-agent</Project>
  <Overview>Claude Code Remote Control server (non-root, read-only NAS access, allowlist proxy only).</Overview>
  <Category>Tools:</Category>
  <WebUI/>
  <TemplateURL/>
  <Icon/>
  <ExtraParams>--hostname=nas01-agent --cap-drop=ALL --security-opt=no-new-privileges --pids-limit=512 --memory=2G</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires>claude-proxy</Requires>
  <Config Name="Config" Target="/config" Default="/mnt/cache/appdata/claude-agent/config" Mode="rw" Description="Claude login, settings, Claude Code program, session history" Type="Path" Display="always" Required="true" Mask="false">/mnt/cache/appdata/claude-agent/config</Config>
  <Config Name="Workspace" Target="/workspace" Default="/mnt/cache/appdata/claude-agent/workspace" Mode="rw" Description="The agent's working folder (its CLAUDE.md, notes, results)" Type="Path" Display="always" Required="true" Mask="false">/mnt/cache/appdata/claude-agent/workspace</Config>
  <Config Name="Secrets" Target="/secrets" Default="/mnt/cache/appdata/claude-agent/secrets" Mode="ro" Description="unraid-api-key (read-only key, mode 400, owner 99:100)" Type="Path" Display="always" Required="true" Mask="false">/mnt/cache/appdata/claude-agent/secrets</Config>
  <Config Name="Policy" Target="/etc/claude-code" Default="/mnt/cache/appdata/claude-agent/policy" Mode="ro" Description="Managed settings (owned by root, read-only)" Type="Path" Display="always" Required="true" Mask="false">/mnt/cache/appdata/claude-agent/policy</Config>
  <Config Name="HTTPS_PROXY" Target="HTTPS_PROXY" Default="http://claude-proxy:3128" Mode="" Description="" Type="Variable" Display="advanced" Required="true" Mask="false">http://claude-proxy:3128</Config>
  <Config Name="HTTP_PROXY" Target="HTTP_PROXY" Default="http://claude-proxy:3128" Mode="" Description="" Type="Variable" Display="advanced" Required="true" Mask="false">http://claude-proxy:3128</Config>
  <Config Name="https_proxy" Target="https_proxy" Default="http://claude-proxy:3128" Mode="" Description="" Type="Variable" Display="advanced" Required="true" Mask="false">http://claude-proxy:3128</Config>
  <Config Name="http_proxy" Target="http_proxy" Default="http://claude-proxy:3128" Mode="" Description="" Type="Variable" Display="advanced" Required="true" Mask="false">http://claude-proxy:3128</Config>
  <Config Name="RC_NAME" Target="RC_NAME" Default="NAS01" Mode="" Description="Name shown in the Claude app" Type="Variable" Display="advanced" Required="false" Mask="false">NAS01</Config>
  <Config Name="TZ" Target="TZ" Default="Europe/London" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">Europe/London</Config>
</Container>
