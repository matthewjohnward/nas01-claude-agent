{
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "mcp__unraid",
      "Bash(notify *)"
    ],
    "deny": [
      "Read(//secrets/**)",
      "Read(//config/.claude/.credentials.json)",
      "Edit(//config/.claude/.credentials.json)",
      "Edit(//config/.claude/settings.json)",
      "Edit(//config/.claude/settings.local.json)",
      "Edit(//config/.claude.json)",
      "Edit(//config/.claude/agents/**)",
      "Edit(//config/.claude/commands/**)",
      "Edit(//config/.claude/skills/**)",
      "Edit(//config/.claude/hooks/**)",
      "Edit(//config/.local/**)",
      "Edit(//etc/claude-code/**)"
    ]
  },
  "useAutoModeDuringPlan": false,
  "cleanupPeriodDays": 365,
  "allowManagedPermissionRulesOnly": true,
  "allowManagedHooksOnly": true,
  "allowManagedMcpServersOnly": true,
  "allowedMcpServers": [
    { "serverCommand": ["/usr/local/bin/unraid-mcp-launch"] }
  ],
  "disableClaudeAiConnectors": true,
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [{ "type": "command", "command": "/usr/local/bin/hook-notify approval", "timeout": 20 }]
      }
    ]
  }
}
